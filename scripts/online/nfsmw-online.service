# systemd unit for the SpeedBreaker online server (nfsmw_server.py).
# Install: copy nfsmw_server.py to /opt/nfsmw-online/, this file to
# /etc/systemd/system/, then: systemctl daemon-reload && systemctl enable --now nfsmw-online
# Ports: 39300 TCP (sign-in) and UDP (race relay), 39301 TCP (EA lobby).
# Files: nfsmw_server.py and nfsmw_lobby.py in /opt/nfsmw-online/.
[Unit]
Description=SpeedBreaker online server (Need for Speed: Most Wanted races)
After=network-online.target
Wants=network-online.target

[Service]
Environment=NFSMW_SERVER_PORT=39300
Environment="NFSMW_SERVER_MOTD=Welcome to SpeedBreaker online."
ExecStart=/usr/bin/python3 -I /opt/nfsmw-online/nfsmw_server.py
Restart=on-failure
RestartSec=3

# Sandbox: no root, no writable files, no new privileges.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
